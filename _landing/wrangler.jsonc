{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Nom du Worker déjà déployé chez Cloudflare. Volontairement NON renommé :
	// changer ce nom crée un second Worker au lieu de mettre à jour celui-ci,
	// et laisse l'ancien servir le trafic. Invisible pour les visiteurs.
	"name": "fintrack-landing",
	"main": "src/index.js",
	"compatibility_date": "2026-09-06",
	// run_worker_first : le Worker voit CHAQUE requête, y compris celles qui
	// correspondent à un fichier de public/.
	//
	// Sans ce réglage, la couche d'assets répond avant le Worker, et la
	// redirection de fintrack.bmsk.ca écrite dans src/index.js ne s'exécutait
	// jamais pour une vraie page : seuls /desabonnement et /api/* la
	// déclenchaient. L'ancien domaine servait donc une copie entière du site,
	// sous l'ancienne marque et en double dans les moteurs de recherche.
	// Constaté en vérifiant le déploiement du 25 octobre, pas en relisant.
	//
	// Prix à payer : une invocation du Worker par requête au lieu de zéro
	// pour les fichiers statiques. Sur une page de présentation, c'est sans
	// portée — le handler se termine par env.ASSETS.fetch(request), donc les
	// fichiers sont servis exactement comme avant.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": true
	},
	// Attaché ici plutôt qu'au tableau de bord : `wrangler deploy` crée le
	// domaine et son enregistrement DNS, puis le réaffirme à chaque déploiement.
	"routes": [
		{
			"pattern": "ando.bmsk.ca",
			"custom_domain": true
		},
		// Ancienne adresse conservée : les courriels de la liste d'attente
		// déjà envoyés contiennent des liens fintrack.bmsk.ca/desabonnement.
		// Le Worker les redirige (301) vers ando.bmsk.ca — voir src/index.js.
		{
			"pattern": "fintrack.bmsk.ca",
			"custom_domain": true
		}
	],
	// Une seule adresse publique, pour ne pas indexer la même page deux fois.
	// Repasser à true pour retrouver une URL *.workers.dev de secours.
	"workers_dev": false,
	"preview_urls": true,
	// Erreurs conservées, mais pas les journaux d'invocation : ils enregistreraient
	// chaque requête reçue, dont /api/logo/<domaine> (la banque consultée).
	// Promesse de la politique de confidentialité : ces requêtes ne sont pas conservées.
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": false
		}
	},
	// Base créée avec : npx wrangler d1 create fintrack-beta
	// Le code n'utilise que la liaison DB (env.DB dans src/index.js).
	// Nom conservé : c'est celui de la base réelle chez Cloudflare, et D1 ne
	// se renomme pas. Seul database_id fait foi pour la liaison.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fintrack-beta",
			"database_id": "a9d727b6-66d5-4659-8503-5132b34afd9b"
		}
	]
}